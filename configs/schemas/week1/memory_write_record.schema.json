{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "memory_consolidation_small_pilot/week1/memory_write_record.schema.json",
  "title": "Week 1 Memory Write Record",
  "type": "object",
  "required": [
    "run_id",
    "benchmark",
    "system",
    "model",
    "phase",
    "session_id",
    "turn_id",
    "raw_input_text",
    "timestamp",
    "cost_metrics",
    "storage_stats"
  ],
  "properties": {
    "run_id": { "type": "string" },
    "benchmark": { "type": "string" },
    "system": { "type": "string" },
    "model": { "type": "string" },
    "phase": { "const": "memory_write" },
    "session_id": { "type": "string" },
    "turn_id": { "type": "integer", "minimum": 0 },
    "raw_input_text": { "type": "string" },
    "timestamp": { "type": "string" },
    "cost_metrics": { "type": "object" },
    "storage_stats": { "type": "object" }
  },
  "additionalProperties": true
}
